# ────────────────────────────────────────────────────────────────────────────
# Adviserve — local environment template
# Copy to `.env` for local dev and `.env.local` for production overrides.
# All `VITE_*` vars are inlined into the client bundle at build time.
# Everything else is server-only and must be set in Vercel project settings.
# ────────────────────────────────────────────────────────────────────────────

# ─── Frontend auth (Supabase) ────────────────────────────────────────────────
# Used by src/lib/supabase.ts for login/logout/session.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Database (Neon Postgres) — server-only ──────────────────────────────────
# Connection string used by api/_db.ts. Required for every API route that
# reads/writes data. Set in Vercel dashboard → Project → Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ─── Admin auth (server-only) ────────────────────────────────────────────────
# Comma-separated allowlist of Supabase emails treated as admin by api/_auth.ts.
# Any user whose verified Supabase session email matches an entry here can hit
# /api/admin/* endpoints. Empty = no admins.
ADMIN_EMAILS=

# ─── CORS extras (server-only) ───────────────────────────────────────────────
# Optional comma-separated list of additional origins allowed to call the API
# beyond the built-in defaults (adviserve.in, localhost). Use for preview
# deployments, custom staging hosts, or partner integrations.
EXTRA_ALLOWED_ORIGINS=

# ─── Site URL (server-only) ──────────────────────────────────────────────────
# Canonical base URL used by api/sitemap.ts when generating <loc> entries.
# Defaults to https://adviserve.in if unset.
SITE_URL=https://adviserve.in

# ─── Transactional email (server-only) ───────────────────────────────────────
# Resend API key + sender. Used by api/apply.ts to notify connect@adviserve.org.in
# of new applications. Sender domain must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=notifications@adviserve.in

# ─── Vercel Blob storage (server-only) ───────────────────────────────────────
# Token for issuing signed client uploads via api/blob-token.ts. Pulled in
# automatically when the Blob integration is enabled on the Vercel project,
# but document it here so local `vercel dev` runs don't 500 silently.
BLOB_READ_WRITE_TOKEN=
